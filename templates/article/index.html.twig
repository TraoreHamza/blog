{% extends 'base.html.twig' %}

{% block title %}Les articles{% endblock %}

{% block body %}
<h1>Les articles</h1>

{% for article in articles %}
    <h3>{{ item.title }}</h3>
    <a href="{{ path('article', { 'slug': item.slug}) }}">Voir l'article</a>
    <hr>
{% endfor %}

{{ knp_pagination_render(articles) }}
{% endblock %}